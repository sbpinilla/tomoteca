{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "archive.error_unreadable": {
      "comment": "Shown when the chosen file is not a readable archive",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file is not a Tomoteca library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo no es una biblioteca de Tomoteca."
          }
        }
      }
    },
    "archive.error_version": {
      "comment": "Shown when the file was written by a newer version of the app",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file was made by a newer version of the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo lo generó una versión más nueva de la app."
          }
        }
      }
    },
    "archive.export_button": {
      "comment": "Button that generates the file and opens the share sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export books"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar libros"
          }
        }
      }
    },
    "archive.export_message": {
      "comment": "Explains what the exported file contains",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a file with your %lld books. Covers and reading sessions are not included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un archivo con tus %lld libros. No incluye portadas ni sesiones de lectura."
          }
        }
      }
    },
    "archive.export_title": {
      "comment": "Heading of the export block",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
